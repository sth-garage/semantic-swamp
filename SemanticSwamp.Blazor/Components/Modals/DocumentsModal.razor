@inject EntityService EntityService
@inject IJSRuntime JS

<!-- Documents Modal -->
<div class="modal fade fun-modal" id="documentsModal" tabindex="-1" aria-labelledby="documentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="documentsModalLabel">
                        <i class="fa-solid fa-folder-open me-2" aria-hidden="true"></i>Document Uploads
                    </h5>
                    <div class="modal-subtitle">Click a row to expand its summary. Download originals from the right.</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                @if (_loading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else if (!_documents.Any())
                {
                    <p class="text-muted text-center py-4">No documents found.</p>
                }
                else
                {
                    <div class="doc-table-wrap">
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th class="expand-col"></th>
                                    <th>Name</th>
                                    <th>Created On</th>
                                    <th>Collection</th>
                                    <th>Category</th>
                                    <th>Active</th>
                                    <th>Processed</th>
                                    <th class="download-col text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in _documents)
                                {
                                    var isExpanded = _expandedIds.Contains(doc.Id);
                                    <tr class="doc-row @(isExpanded ? "expanded selected" : "")"
                                        role="button" tabindex="0"
                                        aria-expanded="@isExpanded.ToString().ToLower()"
                                        @onclick="() => ToggleSummary(doc.Id)"
                                        @onkeydown="e => HandleRowKey(e, doc.Id)">
                                        <td class="expand-col">
                                            <span class="expand-indicator" aria-hidden="true">@(isExpanded ? "-" : "+")</span>
                                        </td>
                                        <td>@doc.FileName</td>
                                        <td>@doc.CreatedOn.ToString("yyyyMMdd_HHmmss")</td>
                                        <td>@doc.CollectionName</td>
                                        <td>@doc.CategoryName</td>
                                        <td>@(doc.IsActive ? "Yes" : "No")</td>
                                        <td>@(doc.HasBeenProcessed ? "Yes" : "No")</td>
                                        <td class="download-col">
                                            <button class="download-btn btn btn-sm btn-outline-secondary" type="button"
                                                    title="Download original"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => DownloadFile(doc.Id, doc.FileName)">
                                                <i class="fa-solid fa-download" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    @if (isExpanded)
                                    {
                                        <tr class="summary-row">
                                            <td colspan="8" class="p-2">
                                                @if (!string.IsNullOrEmpty(doc.Summary))
                                                {
                                                    @doc.Summary
                                                }
                                                else
                                                {
                                                    <em>No summary available.</em>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@code {
    // All uploaded documents fetched from the DB and mapped to view-model rows.
    private List<DocRow> _documents = new();

    // Tracks which document rows are currently expanded to show their summary text.
    // Using a HashSet gives O(1) contains/add/remove for toggle operations.
    private HashSet<int> _expandedIds = new();

    // Controls the loading spinner shown while documents are being fetched.
    private bool _loading;

    // Lightweight view-model that flattens the document record and its related
    // collection/category names into a single type for the table rows.
    private record DocRow(int Id, string FileName, DateTime CreatedOn, string CollectionName,
        string CategoryName, bool IsActive, bool HasBeenProcessed, string? Summary);

    /// <summary>
    /// Opens the modal and loads the document list. Called by Home.razor when the user
    /// clicks the Documents button. The modal is shown immediately (before data loads)
    /// so the user sees the spinner rather than a button that appears to do nothing.
    /// Data is then fetched synchronously via EntityService and StateHasChanged triggers
    /// a re-render to replace the spinner with the populated table.
    /// </summary>
    public async Task ShowAsync()
    {
        _loading = true;
        _expandedIds.Clear();

        // Show the modal first so the user gets immediate visual feedback.
        await JS.InvokeVoidAsync("showBootstrapModal", "documentsModal");
        StateHasChanged();

        // Map SimpleDocumentUpload DTOs (which store CreatedOn as a formatted string)
        // back to DateTime using the exact format used when the record was saved.
        _documents = EntityService.GetDocuments().Select(d =>
        {
            // The CreatedOn string is stored as "yyyyMMdd_HHmmss" by EntityService.
            // TryParseExact returns DateTime.MinValue on failure — safe to display as-is.
            DateTime.TryParseExact(d.CreatedOn, "yyyyMMdd_HHmmss",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var dt);
            return new DocRow(d.Id, d.FileName, dt,
                d.CollectionName, d.CategoryName,
                d.IsActive, d.HasBeenProcessed, d.Summary);
        }).ToList();

        _loading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Toggles the expanded/collapsed state of a document row to show or hide its summary.
    /// HashSet.Remove returns false if the item was not present, so the single expression
    /// handles both "collapse if open" and "expand if closed" without an explicit if/else.
    /// </summary>
    private void ToggleSummary(int id)
    {
        if (!_expandedIds.Remove(id))
            _expandedIds.Add(id);
    }

    /// <summary>
    /// Keyboard handler for document rows so the table is accessible without a mouse.
    /// Enter and Space are the standard keys for activating a focused element.
    /// </summary>
    private void HandleRowKey(KeyboardEventArgs e, int id)
    {
        if (e.Key == "Enter" || e.Key == " ")
            ToggleSummary(id);
    }

    /// <summary>
    /// Triggers a browser file download by calling the window.downloadFile JS helper
    /// defined in swamp.js. The helper creates a temporary anchor element with the
    /// /api/download/{id} URL and clicks it, which causes the browser to fetch the
    /// file from the minimal API endpoint and save it with the original file name.
    /// </summary>
    private async Task DownloadFile(int id, string fileName)
    {
        await JS.InvokeVoidAsync("downloadFile", $"/api/download/{id}", fileName);
    }
}
